{
  "name": "realgoal",
  "version": "0.1.0",
  "description": "Explicit, resumable goal and planning workflow extension for Pi, written in Effect-TS.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal",
    "plan",
    "workflow",
    "effect-ts"
  ],
  "license": "MIT",
